###############################################################################
# DragLogic — production environment template
#
# Copy to your runtime secret store / Azure container env (do NOT commit a real
# .env). Values here are PLACEHOLDERS. DragLogic is a static client-side tool
# with one telemetry endpoint (save.php): it needs NO database, NO
# authentication, and NO application secrets. This template mainly documents
# the platform/runtime contract the container runs under.
#
# Nothing here is baked into the image; the container reads these at runtime.
###############################################################################

# --- Environment flag --------------------------------------------------------
APP_ENV=production
TZ=America/New_York

# --- Ingress / routing -------------------------------------------------------
# Public hostname this container is mapped to by the ingress/proxy.
PUBLIC_HOSTNAME=draglogic.<your-subdomain>.stonybrook.edu
# Apache listens on 8080 inside the container (non-root); the ingress forwards
# 443 -> 8080.
APACHE_LISTEN_PORT=8080

# --- Authentication ----------------------------------------------------------
# NONE. Public static tool. If access must be restricted, enforce it at the
# ingress / reverse proxy (Ansible-managed), not in this container.

# --- Database ----------------------------------------------------------------
# NONE.

# --- Application secrets -----------------------------------------------------
# NONE.

# --- Telemetry (save.php -> record.json) -------------------------------------
# save.php appends saved proofs to record.json inside the container. HTTP reads
# of that file are denied by the image, and it is NOT baked in (recreated on
# first write). It is EPHEMERAL container state — if you need to retain the
# collected proofs across redeploys, mount a volume at
# /var/www/html/record.json (or a parent dir) on writable, non-web-served
# storage. Consider adding auth / rate-limiting to save.php if telemetry is kept.
